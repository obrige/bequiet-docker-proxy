# ===========================================================================
# bequiet-docker-proxy configuration
#
# Copy this file to `.env` and adjust the values:
#
#     cp .env.example .env
#
# docker compose automatically reads `.env` from the project directory.
# Every variable can also be passed directly to `proxy.py` (as an env var or,
# for most of them, a CLI flag that overrides the env value).
# ===========================================================================

# ---------------------------------------------------------------------------
# TUNNEL ENDPOINT  (the "CF URL" + path prefix)
# ---------------------------------------------------------------------------
# The Cloudflare Pages reverse proxy is reached at:  <TUNNEL_HOST><PREFIX><target-url>
# e.g. https://bequiet.pages.dev  +  /fonts/  +  https://example.com/  ->
#      https://bequiet.pages.dev/fonts/https://example.com/

# Origin of the reverse proxy (no trailing slash).
TUNNEL_HOST=https://bequiet.pages.dev

# A single path prefix (must be a path, leading/trailing slashes are added
# automatically if missing).
PREFIX=/fonts/

# --- OR: several prefixes, rotated per request ----------------------------
# Useful if one prefix gets rate-limited. Comma-separated; when set, this
# takes precedence over PREFIX.
# PREFIXES=/fonts/,/proxy/,/go/
#
# Rotation strategy when multiple prefixes are set:
#   first       - always use the first (default)
#   random      - pick a random prefix per request
#   roundrobin  - cycle through them in order
PREFIX_STRATEGY=first

# Backwards-compatible single setting (host + prefix combined). If TUNNEL_HOST
# is not set, this is split into host + prefix automatically.
# TUNNEL_BASE=https://bequiet.pages.dev/fonts/

# ---------------------------------------------------------------------------
# BEHAVIOUR
# ---------------------------------------------------------------------------
# When the tunnel fails (e.g. the target is itself hosted on Cloudflare and the
# Worker returns an error), retry the request DIRECTLY instead of failing.
# This makes Cloudflare-hosted sites load, at the cost of not being tunnelled.
DIRECT_FALLBACK=false

# Only tunnel hosts matching these patterns; empty = tunnel everything.
# Supports: example.com, *.example.com, prefix*, /regex/
# ALLOW_HOSTS=example.com,*.wikipedia.org

# Never tunnel hosts matching these patterns (sent direct if DIRECT_FALLBACK,
# otherwise rejected with 403). Good place for Cloudflare-hosted sites.
# DENY_HOSTS=*.cloudflare.com,*.pages.dev,*.workers.dev

# ---------------------------------------------------------------------------
# OUTBOUND REQUEST TWEAKS
# ---------------------------------------------------------------------------
# Extra headers added to every outbound tunnel request.
# Accepts JSON or a "K: V; K2: V2" list.
# EXTRA_HEADERS={"X-Forwarded-For": "1.2.3.4"}

# Force a specific User-Agent (overrides the client's).
# USER_AGENT=Mozilla/5.0 (compatible; bequiet-proxy)

# Strip the client's User-Agent entirely.
STRIP_UA=false

# Verify the tunnel host's TLS certificate (disable only for self-signed).
VERIFY_SSL=true

# ---------------------------------------------------------------------------
# NETWORKING
# ---------------------------------------------------------------------------
# Host ports published by docker compose (container ports stay 8080/1080).
HTTP_PORT=8080
SOCKS_PORT=1080

# Interface to bind on the host. 127.0.0.1 = localhost only, 0.0.0.0 = LAN.
BIND_ADDR=127.0.0.1

# Bind addresses *inside* the container (rarely changed).
HTTP_HOST=0.0.0.0
SOCKS_HOST=0.0.0.0

# Outbound request timeout, in seconds.
TUNNEL_TIMEOUT=60

# Optional SOCKS5 username/password auth (set both to enable).
# SOCKS_USER=
# SOCKS_PASS=

# ---------------------------------------------------------------------------
# HTTPS INTERCEPTION (MITM)
# ---------------------------------------------------------------------------
# true  -> terminate TLS with the local CA and tunnel HTTPS too
# false -> HTTPS passes through untunnelled (direct)
# You MUST install ./certs/ca.crt into your trust store when true.
MITM_ENABLED=false

# Folder (on the host) holding the CA, bind-mounted into the container at /certs.
CERTS_DIR=./certs

# Generate the CA into CERTS_DIR on first container start (no host openssl).
GEN_CA_ON_START=false

# ---------------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
