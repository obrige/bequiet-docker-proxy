# ---------------------------------------------------------------------------
# bequiet-docker-proxy configuration
#
# Copy this file to `.env` and adjust the values:
#
#     cp .env.example .env
#
# docker compose automatically reads `.env` from the project directory.
# ---------------------------------------------------------------------------

# The Cloudflare Pages reverse-proxy prefix (the "CF URL").
# Swap this for your own deployment if you self-host the Worker.
# MUST end with a slash.
TUNNEL_BASE=https://bequiet.pages.dev/fonts/

# Host ports that are published. Container-internal ports stay 8080/1080.
HTTP_PORT=8080
SOCKS_PORT=1080

# Bind address on the host. Use 127.0.0.1 to restrict to localhost only,
# or 0.0.0.0 to expose on the LAN.
BIND_ADDR=127.0.0.1

# Outbound request timeout, in seconds.
TUNNEL_TIMEOUT=60

# ---- HTTPS interception (MITM) -------------------------------------------
# When true, the proxy terminates TLS using certificates signed by the local
# CA in ./certs, so HTTPS traffic is tunnelled too. You MUST install
# ./certs/ca.crt into your browser/OS trust store, otherwise you'll get
# certificate warnings.
#
# NOTE: HTTPS interception only works through the HTTP proxy (CONNECT).
# If you don't need it, leave this false and HTTPS will pass through
# untunnelled (direct) so sites still work, just without the tunnel.
MITM_ENABLED=false

# Directory (on the host) holding the CA and generated leaf certificates.
# It is bind-mounted into the container at /certs.
CERTS_DIR=./certs

# ---- Optional SOCKS5 auth ------------------------------------------------
# Set both to require username/password auth on the SOCKS5 listener.
# SOCKS_USER=
# SOCKS_PASS=
